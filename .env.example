# ==============================================================================
# .env.example - Scenario Configuration Variables
# ==============================================================================

# [OOM 시나리오 테스트]
# MEMORY_LIMIT=128        # Before (기본 128MB)
# MEMORY_LIMIT=256        # After 1 (256MB)
# MEMORY_LIMIT=512        # After 2 (512MB)
MEMORY_LIMIT=128

# [CPU 과점유 시나리오 테스트]
# CPU_MAX_OCCUPY=30       # 임계치 낮게 설정 시 빠른 Watchdog 트리거
# CPU_MAX_OCCUPY=80       # 상향 조정 비교군
CPU_MAX_OCCUPY=50

# [Deadlock 시나리오 테스트]
# MULTI_THREAD_ENABLE=true   # 교착 상태 재현 (Before)
# MULTI_THREAD_ENABLE=false  # 싱글 스레드로 회피 (After)
MULTI_THREAD_ENABLE=true
